# Example Backend environment variables
# SUPABASE URL and KEY (required for uploads/export)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# PORT to run the backend on
PORT=3000

# Comma separated allowed origins for CORS (leave blank to allow any origin)
ALLOWED_ORIGINS=http://localhost:5173,https://yourfrontend.example.com

# NODE_ENV=production
